# Exemple de configuration de production. Ne pas remplir ce fichier : le générer
# hors dépôt avec scripts/generate_prod_secrets.sh, qui remplace chaque valeur
# `change-me`, puis compléter les noms d'hôtes (voir deploy/README.txt).

# ── Chemins ──────────────────────────────────────────────────────────────
BETORUN_SECRETS_DIR=/opt/betorun/secrets
# Propriétaire de keycloak.env (renseigné par le script).
OPERATOR_UID=0

# ── Images (tag exact, jamais latest) ────────────────────────────────────
# Peuvent être surchargées par images.env (déploiement automatique).
KUBEMANAGER_IMAGE=thekrauss/kubemanager:remplacer-par-le-sha
STATIC_EDGE_IMAGE=thekrauss/static-edge:remplacer-par-le-sha
CONSOLE_IMAGE=thekrauss/kweb:remplacer-par-le-sha

# ── Noms publics ─────────────────────────────────────────────────────────
ACME_EMAIL=ops@example.com
CONSOLE_HOST=app.example.com
API_HOST=api.example.com
REGISTRY_HOST=registry.example.com
REALTIME_HOST=realtime.example.com
# Sites : <sous-domaine>.sites.example.com (enregistrement joker vers le serveur 1).
SITES_BASE_DOMAIN=sites.example.com
# Cible CNAME donnée aux clients pour leurs domaines de sites (serveur 1).
SITES_EDGE_TARGET=edge.example.com
# IP publique du serveur 2 : URL <conteneur>-<projet>.<ip>.sslip.io et domaines
# personnalisés des conteneurs.
SERVER2_IP=203.0.113.20
# Emails du staff (rôle platform.admin), séparés par des virgules.
PLATFORM_ADMINS=ops@example.com

# ── Emails (fournisseur SMTP réel, obligatoire) ──────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=betorun

# ── Base de données ──────────────────────────────────────────────────────
DB_USER=betorun
DB_NAME=betorun
# Hexadécimal uniquement : le DSN est construit sans échappement.
DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
TEMPORAL_DB_PASSWORD=change-me
EDGE_DB_PASSWORD=change-me

# ── Services internes ────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=betorun-admin
KEYCLOAK_ADMIN_PASSWORD=change-me
CENTRIFUGO_API_KEY=change-me
CENTRIFUGO_TOKEN_HMAC_SECRET=change-me
S3_PLATFORM_SECRET_KEY=change-me
S3_EDGE_SECRET_KEY=change-me
REGISTRY_HTTP_SECRET=change-me
BUILDS_SECRET=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# ── DÉFINITIFS dès le premier démarrage ──────────────────────────────────
# Changer le pepper invalide toutes les clés API. Changer la clé STS rend
# illisibles les clés de signature et les variables chiffrées des conteneurs.
# À sauvegarder hors du serveur.
IAM_API_KEY_PEPPER=change-me
# Seule exception à l'hexadécimal : 32 octets en base64 (jamais dans un DSN).
IAM_STS_KEY_ENCRYPTION_KEY=change-me

# ── Facultatifs ──────────────────────────────────────────────────────────
# Swagger : désactivé si vide.
SWAGGER_USER=
SWAGGER_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CLUSTER_ID=
TRACING_JAEGER_ENDPOINT=
LOG_LEVEL=info
# Par IP. Assez haut pour les opérateurs mobiles (beaucoup d'abonnés par IP).
RATE_LIMIT_PER_MINUTE=600
BUILDS_MAX_CONCURRENT=1
BUILDS_MEMORY_LIMIT=2Gi
# Adresses privées joignables par les builds, si API ou registre y résolvent.
BUILDS_EGRESS_ALLOW_CIDRS=
WORKER_MAX_CONCURRENT_ACTIVITIES=6
