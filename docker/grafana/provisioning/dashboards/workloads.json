{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "type": "timeseries",
      "title": "POST /workloads — rate & errors",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (code) (rate(gin_requests_total{handler=~\".*workloads.*\", method=\"POST\"}[1m]))", "legendFormat": "{{code}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "POST /workloads — latency P50/P95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(gin_request_duration_seconds_bucket{handler=~\".*workloads.*\", method=\"POST\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(gin_request_duration_seconds_bucket{handler=~\".*workloads.*\", method=\"POST\"}[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Rate limit 429 (all endpoints)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (handler) (rate(gin_requests_total{code=\"429\"}[1m]))", "legendFormat": "{{handler}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Auth failures (401 / 403)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (code) (rate(gin_requests_total{code=~\"401|403\"}[1m]))", "legendFormat": "{{code}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "logs",
      "title": "Workloads workflow events (Loki)",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{job=\"kubemanager\"} |~ \"workload\" | json | line_format \"{{.msg}} status={{.status}} workflow={{.workflow_id}}\"" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["kubemanager", "workloads"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "title": "KubeManager — Workloads lifecycle",
  "uid": "km-workloads",
  "version": 1
}
